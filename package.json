{
  "name": "love-bites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "brand": "tsx scripts/brand.ts",
    "kitchen-code": "tsx scripts/kitchen-code.ts",
    "data:fetch": "tsx scripts/fetch-sources.ts",
    "data:products": "tsx scripts/build-products.ts",
    "data:recipes": "tsx scripts/build-recipes.ts",
    "data:catalog": "tsx scripts/build-catalog.ts",
    "data:audit": "tsx scripts/audit.ts",
    "data:all": "npm run data:fetch && npm run data:products && npm run data:recipes && npm run data:catalog && npm run data:audit",
    "data:refresh-prices": "tsx scripts/fetch-sources.ts --only woolworths && npm run data:products && npm run data:catalog && npm run data:audit",
    "recipes:discover": "tsx scripts/discover-recipes.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "csv-parse": "^7.0.3",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
